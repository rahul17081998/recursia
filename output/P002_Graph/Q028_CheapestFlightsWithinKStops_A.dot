digraph G {
  graph [nodesep=0.7, ranksep=0.9, size="8,8", ratio=compress, dpi=180];
  node [shape=circle, style=filled, fillcolor=lightblue, fontsize=16, width=0.6];
  0;
  1;
  2;
  3;
  0 -> 1 [label="100", fontsize=14];
  1 -> 2 [label="100", fontsize=14];
  2 -> 0 [label="100", fontsize=14];
  1 -> 3 [label="600", fontsize=14];
  2 -> 3 [label="200", fontsize=14];
}
