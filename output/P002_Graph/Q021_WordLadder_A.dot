graph G {
  graph [nodesep=0.7, ranksep=0.9, size="8,8", ratio=compress, dpi=180];
  node [shape=circle, style=filled, fillcolor=lightblue, fontsize=14, width=0.7];
  "hit";
  "hot";
  "dot";
  "dog";
  "lot";
  "log";
  "cog";
  "hit" -- "hot";
  "hot" -- "dot";
  "hot" -- "lot";
  "dot" -- "dog";
  "dot" -- "lot";
  "dog" -- "log";
  "dog" -- "cog";
  "lot" -- "log";
  "log" -- "cog";
}
