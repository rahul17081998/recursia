graph G {
  graph [nodesep=0.7, ranksep=0.9, size="8,8", ratio=compress, dpi=180];
  node [shape=circle, style=filled, fillcolor=lightblue, fontsize=16, width=0.6];
  0;
  1;
  2;
  3;
  4;
  0 -- 1 [label="4", fontsize=14];
  0 -- 2 [label="8", fontsize=14];
  1 -- 4 [label="6", fontsize=14];
  2 -- 3 [label="2", fontsize=14];
  3 -- 4 [label="10", fontsize=14];
}
